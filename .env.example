# Flask
FLASK_DEBUG=1
PORT=5000

# KG Agent LLM 模式（可选）
# disabled: 不启用真实大模型，仍可运行固定工具 + few-shot 模板链路
# local_transformers: 使用本地 transformers + LangChain 模型
# openai: 使用 OpenAI 兼容 API（可直接接 DeepSeek）
KG_AGENT_LLM_MODE=disabled

# 仅在 KG_AGENT_LLM_MODE=openai 时生效
OPENAI_API_KEY=
# 如果你使用 DeepSeek，也可以直接填这个
# DEEPSEEK_API_KEY=
KG_AGENT_OPENAI_MODEL=deepseek-v4-flash
KG_AGENT_OPENAI_BASE_URL=https://api.deepseek.com

# 仅在 KG_AGENT_LLM_MODE=local_transformers 时生效
# KG_AGENT_LLM_MODEL_DIR=D:/models/your-local-model
KG_AGENT_LLM_MAX_NEW_TOKENS=768
KG_AGENT_LLM_TEMPERATURE=0.1
KG_AGENT_LLM_DEVICE=auto
KG_AGENT_LLM_LOAD_IN_4BIT=0

# fallback 是否允许追加“模型参考说明”
# 0: 只输出图谱结论和谨慎说明
# 1: 允许在图谱结论后追加“模型参考说明：以下内容来自大模型内部知识，仅供参考，不作为本地图谱查询结论。”
KG_AGENT_LLM_REFERENCE_MODE=0
